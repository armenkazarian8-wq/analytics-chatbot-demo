# Optional LLM for free-text answers. Leave unset to use the deterministic fallback.
# Prefer Gemini when both are set.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Database: leave unset for SQLite (default). For Postgres+pgvector:
# DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5432/analytics_chat
# USE_PGVECTOR=1
